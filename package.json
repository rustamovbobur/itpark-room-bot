{
  "name": "itpark-room-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply itpark-rooms --local",
    "db:remote": "wrangler d1 migrations apply itpark-rooms --remote",
    "telegram:setup": "node --env-file=.dev.vars scripts/telegram-setup.js",
    "secrets": "node --env-file=.dev.vars scripts/upload-secrets.js"
  },
  "devDependencies": {
    "wrangler": "4.142.0",
    "miniflare": "5.20260926.0-alpha"
  }
}
